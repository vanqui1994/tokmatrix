TOKMATRIX_PORT=8080
TOKMATRIX_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
TOKMATRIX_WIREPROXY_PATH=/absolute/path/to/wireproxy
TOKMATRIX_COMPARE_DIR=/absolute/path/to/auto-compare-video-mod

# Dola Render Gateway (bkt_web/dola_video.py). Key: Kho Khoá `video.dola` hoặc DOLA_API_KEY (trống = dev mode)
DOLA_GATEWAY_BASE_URL=http://localhost:8000
DOLA_API_KEY=
DOLA_DEFAULT_MODEL=seedance-2.0
DOLA_POLL_INTERVAL_MS=5000
# Để trống = tự chọn: 300 s (10/15 s), 900 s (30 s hoặc có ảnh tham chiếu)
DOLA_TIMEOUT_SECONDS=
# Pool nhiều gateway/key (tự chuyển khi hết lượt). Mẫu: docs/dola_accounts.example.json.
# Không đặt = một tài khoản "default" từ DOLA_GATEWAY_BASE_URL + DOLA_API_KEY.
DOLA_ACCOUNTS_FILE=bkt_web/storage/dola_accounts.json
# Giờ reset hạn mức ngày; để trùng DOLA_LIMIT_RESET_TZ của gateway (mặc định gateway là Asia/Tokyo)
DOLA_LIMIT_RESET_TZ=Asia/Tokyo
# Khoá admin của gateway cho trang "Quản trị gateway" (hoặc Kho Khoá video.dola_admin); trống = trang tự hỏi
DOLA_ADMIN_KEY=
