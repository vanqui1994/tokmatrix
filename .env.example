TOKMATRIX_PORT=8080
TOKMATRIX_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
TOKMATRIX_WIREPROXY_PATH=/absolute/path/to/wireproxy
TOKMATRIX_COMPARE_DIR=/absolute/path/to/auto-compare-video-mod
# Shared secret for localhost-only CLI/workers that call protected internal APIs.
# Generate a long random value on the server; do not commit the real token.
TOKMATRIX_INTERNAL_TOKEN=replace-with-random-secret
