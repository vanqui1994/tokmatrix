# ── TTS Provider ─────────────────────────────────────────────
# "vbee" = Vbee TTS (cần tài khoản) | "edge" = Edge TTS (miễn phí, pure Node.js via edge-tts-universal)
TTS_PROVIDER=edge

# ── Edge TTS (chỉ cần khi TTS_PROVIDER=edge) ────────────────
# Giọng đọc theo ngôn ngữ của video (VIDEO_LANG trong scripts/generate-vo.mjs).
# vi: vi-VN-NamMinhNeural / vi-VN-HoaiMyNeural
# en: en-US-AndrewNeural / en-US-AvaNeural
# de: de-DE-ConradNeural / de-DE-KatjaNeural
# fr: fr-FR-HenriNeural / fr-FR-DeniseNeural
# ja: ja-JP-KeitaNeural / ja-JP-NanamiNeural
# ko: ko-KR-InJoonNeural / ko-KR-SunHiNeural
EDGE_VOICE_VI=vi-VN-NamMinhNeural
EDGE_VOICE_EN=en-US-AndrewNeural
EDGE_VOICE_DE=de-DE-ConradNeural
EDGE_VOICE_FR=fr-FR-HenriNeural
EDGE_VOICE_JA=ja-JP-KeitaNeural
EDGE_VOICE_KO=ko-KR-InJoonNeural

# Fallback khi ngôn ngữ của video không có biến riêng ở trên
EDGE_VOICE=en-US-AndrewNeural

# ── Vbee TTS (chỉ cần khi TTS_PROVIDER=vbee; chỉ có giọng tiếng Việt) ──
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Giọng đọc Vbee — danh sách khác xem vbee.md hoặc trên trang chủ vbee § 5
VBEE_VOICE_CODE=



# ── Video series ─────────────────────────────────────────────
# Tên kênh hiển thị trên eyebrow tag (#eyebrow) trong mọi video
CHANNEL=Cường IT

# 0 = skill dừng lại xác nhận từng bước | 1 = chạy tự động không hỏi
AUTO_CREATE_VIDEO=0
