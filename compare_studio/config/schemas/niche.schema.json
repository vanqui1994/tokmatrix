{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "niche.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["niche_id", "name", "language", "summary", "allowed_engines"],
  "properties": {
    "niche_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "summary": { "type": "string", "minLength": 1 },
    "allowed_engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
