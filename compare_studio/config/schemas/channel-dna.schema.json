{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "channel-dna.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_id", "config_version", "niche_id", "name", "tiktok_account_ref", "persona", "story", "creative", "audio", "publishing"],
  "properties": {
    "channel_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "config_version": { "type": "integer", "minimum": 1 },
    "niche_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "tiktok_account_ref": { "type": ["string", "null"], "minLength": 1 },
    "persona": {
      "type": "object", "additionalProperties": false,
      "required": ["tone", "energy_level", "target_demographic", "catchphrase_prefix"],
      "properties": {
        "tone": { "type": "string", "minLength": 1 },
        "energy_level": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "target_demographic": { "type": "string", "minLength": 1 },
        "catchphrase_prefix": { "type": "string", "minLength": 1 }
      }
    },
    "story": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred_blueprints", "preferred_hook_types", "target_duration_seconds", "pacing_beats"],
      "properties": {
        "preferred_blueprints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "preferred_hook_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "target_duration_seconds": { "type": "integer", "minimum": 25, "maximum": 65 },
        "pacing_beats": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "creative": {
      "type": "object", "additionalProperties": false,
      "required": ["preferred_engines", "visual_style_id", "cut_cadence_seconds", "palette"],
      "properties": {
        "preferred_engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "visual_style_id": { "type": "string", "minLength": 1 },
        "cut_cadence_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "skins": {
          "type": "object",
          "description": "Bộ da cố định theo engine (docs/PLAN_compare_per_country.md). Sinh bằng tools/assign-skins.mjs.",
          "propertyNames": { "pattern": "^[a-z]+$" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["variant_id", "dna"],
            "properties": {
              "variant_id": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+$" },
              "dna": {
                "type": "object", "additionalProperties": false,
                "required": ["dna_version", "variant_version", "composition", "typography", "treatment", "image_motion", "transition", "tone", "caption"],
                "properties": {
                  "dna_version": { "type": "integer", "minimum": 1 },
                  "variant_version": { "type": "integer", "minimum": 1 },
                  "composition": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                  "typography": { "type": "string", "minLength": 1 },
                  "treatment": { "type": "string", "minLength": 1 },
                  "image_motion": { "type": "string", "minLength": 1 },
                  "transition": { "type": "string", "minLength": 1 },
                  "tone": { "type": "integer", "minimum": 0 },
                  "caption": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "palette": {
          "type": "object", "additionalProperties": false, "required": ["primary", "accent", "text"],
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "variant_id": { "type": "string", "pattern": "^[a-z]+/[a-z0-9-]+$" },
        "dna": {
          "type": "object", "additionalProperties": false,
          "required": ["dna_version", "variant_version", "composition", "typography", "treatment", "image_motion", "transition", "tone", "caption"],
          "properties": {
            "dna_version": { "type": "integer", "minimum": 1 },
            "variant_version": { "type": "integer", "minimum": 1 },
            "composition": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "typography": { "type": "string", "minLength": 1 },
            "treatment": { "type": "string", "minLength": 1 },
            "image_motion": { "type": "string", "minLength": 1 },
            "transition": { "type": "string", "minLength": 1 },
            "tone": { "type": "integer", "minimum": 0 },
            "caption": { "type": "string", "minLength": 1 }
          }
        }
      },
      "dependencies": { "variant_id": ["dna"], "dna": ["variant_id"] }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["voice_id", "voice_speed", "voice_pitch", "music_family", "soundscape_id", "sfx_density"],
      "properties": {
        "voice_id": { "type": "string", "minLength": 1 },
        "voice_speed": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "voice_pitch": { "type": "number", "minimum": -12, "maximum": 12 },
        "music_family": { "type": "string", "minLength": 1 },
        "soundscape_id": { "type": "string", "enum": ["compare", "survival", "science", "mystery", "vox", "newspaper", "kinetic"] },
        "sfx_density": { "type": "string", "enum": ["low", "medium", "high"] },
        "voice_fx": { "type": "string", "enum": ["none", "creepy", "whisper", "radio"] },
        "voice_clone": { "type": "string", "pattern": "^(none|[a-z0-9][a-z0-9_-]{1,63})$" },
        "bgm_pool": {
          "description": "CC0 background-music pool (track ids of config/music/cc0_catalog.json, set by tools/assign-music.mjs). Absent = legacy soundscape BGM.",
          "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" }
        }
      }
    },
    "publishing": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "default_schedule_window", "hashtags"],
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z]{2}$" },
        "default_schedule_window": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "hashtags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
