{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokmatrix.local/schemas/analysis_result_v1.schema.json",
  "title": "AnalysisResultV1",
  "$defs": {
    "ActionObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "title": "Observation Id",
          "type": "string"
        },
        "analyzer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "title": "Analyzer Id",
          "type": "string"
        },
        "source_interval": {
          "$ref": "#/$defs/Interval"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "review_status": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "accepted",
            "corrected",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "maxItems": 100,
          "title": "Alternatives",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "extensions": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extensions"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Label",
          "type": "string"
        },
        "actor_track_ref": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Track Ref"
        },
        "target_track_ref": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Track Ref"
        }
      },
      "required": [
        "observation_id",
        "analyzer_id",
        "source_interval",
        "confidence",
        "evidence_ids",
        "kind",
        "label"
      ],
      "title": "ActionObservation",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "description": "A competing reading the analyzer could not rule out.",
      "properties": {
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Analyzer": {
      "additionalProperties": false,
      "properties": {
        "analyzer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "title": "Analyzer Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "shot",
            "transcript",
            "ocr",
            "track",
            "pose",
            "action",
            "camera",
            "audio",
            "multi"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "ran_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ran At"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "analyzer_id",
        "kind",
        "name",
        "version"
      ],
      "title": "Analyzer",
      "type": "object"
    },
    "AnalyzerFailure": {
      "additionalProperties": false,
      "description": "A analyzer that did not finish. Recorded, so partial results stay usable.",
      "properties": {
        "failure_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "title": "Failure Id",
          "type": "string"
        },
        "analyzer_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$",
          "title": "Analyzer Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unavailable",
            "timeout",
            "unsupported_media",
            "low_quality_input",
            "internal_error",
            "cancelled"
          ],
          "title": "Reason",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "covered": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "failure_id",
        "analyzer_id",
        "reason"
      ],
      "title": "AnalyzerFailure",
      "type": "object"
    },
    "AudioEventObservation": {
      "additionalProperties": false,
