          ],
          "default": null,
          "title": "Speaker Label"
        },
        "loudness_lufs": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": -120,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loudness Lufs"
        },
        "peak_db": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": -120,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Db"
        }
      },
      "required": [
        "observation_id",
        "analyzer_id",
        "source_interval",
        "confidence",
        "evidence_ids",
        "kind",
        "category"
      ],
      "title": "AudioEventObservation",
      "type": "object"
    },
