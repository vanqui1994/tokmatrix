          "maxItems": 1000,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "review_status": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "accepted",
            "corrected",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "alternatives": {
          "items": {
