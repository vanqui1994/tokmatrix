    "cues": [
      {
        "start": 0.11,
        "end": 1.39,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Tớ còn chưa chín mà!",
        "original_text": "我还没成熟",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 1.39,
        "end": 2.87,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Cậu cầm dao làm gì thế?",
        "original_text": "你拿把刀干什么",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 2.87,
        "end": 5.99,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Tớ đến lấy thứ còn đắt hơn cả quả đu đủ cơ.",
        "original_text": "我是来收集比木瓜果子更值钱的东西",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 5.99,
        "end": 7.35,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Thứ gì vậy?",
        "original_text": "那是什么东西",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 8.71,
        "end": 9.75,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Sao lại rạch tớ?",
        "original_text": "你割我干什么",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 9.75,
        "end": 12.47,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Nhỡ tớ chảy hết nhựa rồi khô héo thì sao?",
        "original_text": "要是我流干汁液枯死该怎么办",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 12.47,
        "end": 15.31,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Chất trắng chảy ra không phải máu đâu.",
        "original_text": "你流出来的白色液体不是血",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 15.31,
        "end": 16.71,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Đó là nhựa đu đủ!",
        "original_text": "是木瓜乳汁",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 16.71,
        "end": 19.03,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Nhựa này còn đắt hơn cả quả đấy.",
        "original_text": "这乳汁卖得比木瓜果子还贵",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 19.03,
        "end": 20.11,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Thật hả?",
        "original_text": "真的假的",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 20.11,
        "end": 23.31,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Trong nhựa đu đủ có enzyme papain.",
        "original_text": "木瓜乳汁里含有木瓜蛋白酶",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 23.31,
        "end": 27.15,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Dùng làm bột mềm thịt, thuốc, mỹ phẩm và chế biến thực phẩm.",
        "original_text": "能用在嫩肉粉药品护肤品和食品加工里",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 27.15,
        "end": 28.87,
        "speaker": "knife",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV075_streaming",
        "text": "Vì thế nó mới đắt đấy!",
        "original_text": "这就是高价的原因",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 29.27,
        "end": 30.55,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "À, ra là vậy!",
        "original_text": "原来是这样",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 30.55,
        "end": 32.63,
        "speaker": "papaya_tree",
        "voice_role": "young_1",
        "engine": "capcut",
        "voice": "BV421_vivn_streaming",
        "text": "Thế rạch thêm vài đường nữa đi!",
        "original_text": "再多划几道口子",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 35.08,
        "end": 36.45,
        "speaker": "narrator",
        "voice_role": "narrator",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "Vài phút sau…",
        "original_text": "A few minutes later",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 36.5,
        "end": 38.06,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "Rạch nông quả đu đủ xanh",
        "original_text": "给青木瓜划浅口",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 38.06,
        "end": 40.06,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "là lấy được nhựa bên trong.",
        "original_text": "就能导出内部的木瓜乳汁",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 40.06,
        "end": 41.78,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "Papain trong nhựa đu đủ",
        "original_text": "乳汁里的木瓜蛋白酶",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 41.78,
        "end": 43.46,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "dùng nhiều để làm mềm thịt,",
        "original_text": "广泛用于嫩肉产品",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 43.46,
        "end": 45.98,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "làm thuốc, mỹ phẩm và chế biến thực phẩm.",
        "original_text": "医药美妆和食品加工行业",
        "translation_verified": true,
        "speaker_verified": true
      },
      {
        "start": 45.98,
        "end": 48.4,
        "speaker": "farmer",
        "voice_role": "adult",
        "engine": "capcut",
        "voice": "BV560_streaming",
        "text": "Bảo sao nhựa đu đủ lại có giá đến thế!",
        "original_text": "难怪这木瓜乳汁价值这么高",
        "translation_verified": true,
        "speaker_verified": true
      }
    ]
  },
